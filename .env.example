# Privy App ID - Get yours from https://privy.io
NEXT_PUBLIC_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# DFlow API Configuration
# Get your API key from https://pond.dflow.net
NEXT_PUBLIC_DFLOW_API_URL=https://api.dflow.net/v1
NEXT_PUBLIC_DFLOW_API_KEY=YOUR_DFLOW_API_KEY

# Kalshi API Configuration
# Get your API credentials from https://docs.kalshi.com
NEXT_PUBLIC_KALSHI_API_URL=https://api.calendar.kalshi.com/trade-api/v2
NEXT_PUBLIC_KALSHI_API_KEY_ID=YOUR_KALSHI_API_KEY_ID
NEXT_PUBLIC_KALSHI_API_SECRET=YOUR_KALSHI_API_SECRET

# Solana RPC Configuration
# Use a public RPC or your own (e.g., Helius, QuickNode)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
