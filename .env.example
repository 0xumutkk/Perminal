# Privy App ID - Get yours from https://privy.io
NEXT_PUBLIC_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# DFlow Trade API Configuration
# Trade API base (see https://pond.dflow.net/quickstart/trade-tokens)
NEXT_PUBLIC_DFLOW_API_URL=https://quote-api.dflow.net
NEXT_PUBLIC_DFLOW_API_KEY=YOUR_DFLOW_API_KEY

# DFlow Prediction Markets Metadata API (for tokenized Kalshi markets)
# Base URL provides market metadata with YES/NO SPL token mints
DFLOW_MARKETS_API_URL=https://prediction-markets-api.dflow.net
DFLOW_API_KEY=YOUR_DFLOW_API_KEY

# Kalshi API Configuration (deprecated - use dFlow Prediction Markets API instead)
# NEXT_PUBLIC_KALSHI_API_URL=https://api.calendar.kalshi.com/trade-api/v2
# NEXT_PUBLIC_KALSHI_API_KEY_ID=YOUR_KALSHI_API_KEY_ID
# NEXT_PUBLIC_KALSHI_API_SECRET=YOUR_KALSHI_API_SECRET

# Solana RPC Configuration
# Use a public RPC or your own (e.g., Helius, QuickNode)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Supabase Configuration - Get yours from https://supabase.com
# Go to Project Settings > API to find these values
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

